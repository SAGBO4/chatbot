# Production Caddyfile reverse proxy configuration for Support Bot Backend
# Protects sensitive query tokens (e.g. Brevo ?token=...) from leaking into access logs.

support.example.com {
    # Redact sensitive query parameters (such as token) from access logs
    log {
        output file /var/log/caddy/access.log
        format filter {
            wrap json
            fields {
                uri query {
                    replace token REDACTED
                }
            }
        }
    }

    # Reverse proxy to FastAPI backend
    reverse_proxy 127.0.0.1:8000
}
