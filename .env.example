# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Admin/support group: receives ticket cards, agent resolution replies, and
# moderation confirmations. Never shown to community members. Fixed via this
# env var only - unlike the community group below, it cannot be changed from
# within Telegram, so it can't be hijacked by a compromised bot command.
TELEGRAM_SUPPORT_GROUP_ID=-1001234567890

# Bot owner: the only Telegram user id always authorized to run
# /setup_community, /whitelist (to grant that same right to other admins),
# and /language. Deliberately env-only, so this root authority can never be
# changed from within Telegram. Find your own Telegram user id by messaging
# @userinfobot (or any similar bot) on Telegram.
BOT_OWNER_TELEGRAM_ID=

# LEGACY one-time seed only - new deployments should leave this unset and
# configure the community group by messaging the bot (/start as the owner
# shows a setup tutorial) then running /setup_community in the target group.
# If set, its value is copied into the persisted setting on first startup
# (and only if no community group has ever been configured yet), then never
# read again - /setup_community is the only way to change it afterwards.
TELEGRAM_COMMUNITY_GROUP_ID=

# Persistent Telegram Mini App (Web App) URL (MUST be https://)
# When set, the bot automatically configures the chat menu button to launch the WebApp.
TELEGRAM_WEBAPP_URL=

# Seconds a group-triggered answer's YES/NO buttons stay active before being
# disabled.
COMMUNITY_RESOLUTION_TIMEOUT_SECONDS=600

# Crypto market data (CoinGecko, no API key required for these endpoints)
CRYPTO_PROVIDER_TIMEOUT_SECONDS=10.0
CRYPTO_CACHE_TTL_SECONDS=45

# PostgreSQL for docker-compose.prod.yml (docker-compose.yml uses SQLite and ignores these).
# POSTGRES_PASSWORD has no default: the production stack refuses to start without it. It is embedded
# in DATABASE_URL, so use URL-safe characters only, e.g. `openssl rand -hex 24`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=chatbot

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
DATABASE_URL=sqlite+aiosqlite:///./data/chatbot.db

# Knowledge Base & AI Configuration
AI_ENABLED=false
AI_API_KEY=
# Provider: "openai", "gemini", or "deepseek"
# "openai" also enables automatic speech-to-text (Whisper) for voice replies
# from a support agent in the Telegram Support Group.
AI_PROVIDER=gemini
# Model name for the selected provider. Leave empty to use a sane default per
# provider (gpt-4o-mini / gemini-2.5-flash / deepseek-chat).
AI_MODEL=
KB_CONFIDENCE_THRESHOLD=0.3

# Support Email & SMTP Configuration
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=support@example.com
SUPPORT_EMAIL_RECIPIENT=support-team@example.com
SMTP_USE_TLS=true

# Secret used to verify the HMAC-SHA256 signature (X-Webhook-Signature header)
# of requests to /api/webhooks/email-inbound. Required in production; set it
# to a long random value and share it only with your trusted email relay.
EMAIL_WEBHOOK_SECRET=

# Shared secret Brevo sends back as a ?token= query parameter on every call to
# /api/webhooks/email-inbound/brevo (Brevo signs nothing itself). Required to
# use Brevo's native Inbound Parsing webhook; set it to a long random value
# and configure the same value in Brevo's dashboard webhook URL.
BREVO_INBOUND_SECRET=

# Comma-separated list of authorized email addresses or domains allowed to resolve
# tickets via inbound email webhooks (e.g. "@company.com, support@company.com").
# Leave empty to accept all senders presenting valid webhook secrets.
ALLOWED_SUPPORT_EMAIL_SENDERS=

# Shared secret the Telegram bot must send (X-API-Key header) to call the
# backend API. Required whenever the backend is reachable over a network you
# don't fully control (e.g. hosted on a public VPS). Set it to a long random
# value and keep the same value here and wherever the bot process runs.
API_KEY=

# Comma-separated list of origins allowed to call this API from a browser.
# "*" is fine for local testing/dev, or if nothing ever calls this API from a
# browser (only the bot does, via X-API-Key, not CORS). Restrict this to your
# real domain(s) once you put a web frontend in front of it.
CORS_ALLOWED_ORIGINS=*
