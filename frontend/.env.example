# Read by the Next.js server only (the proxy in src/app/api/backend).
# Never prefix these with NEXT_PUBLIC_: that would ship them to the browser.

# Where the FastAPI backend is reachable from the Next.js server.
BACKEND_API_URL=http://127.0.0.1:8000

# Must equal API_KEY in the backend .env; sent as the X-API-Key header.
BACKEND_API_KEY=

# Must be the same bot token as TELEGRAM_BOT_TOKEN in the backend .env;
# used to verify the signature of the Telegram Mini App session (initData).
TELEGRAM_BOT_TOKEN=
